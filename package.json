{
  "name": "@cocreate/autoscaler",
  "version": "1.1.0",
  "description": "Decentralized, masterless P2P autoscaling engine for CoCreate Server. Executes autonomous horizontal and vertical multi-cloud adjustments driven by real-time tenant telemetry.",
  "keywords": [
    "cocreate",
    "cocreate-server",
    "autoscaler",
    "cluster-orchestration",
    "p2p-replication",
    "decentralized-scaling",
    "cloud-native",
    "self-healing",
    "cooperative-draining",
    "multi-cloud-adapter",
    "telemetry-driven"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "webpack --config webpack.config.js",
    "build": "webpack --mode=production --config webpack.config.js",
    "dev": "webpack --config webpack.config.js --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoCreateJS/autoscaler.git"
  },
  "author": "CoCreate LLC",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/CoCreateJS/autoscaler/issues"
  },
  "homepage": "https://CoCreateJS.com/docs/autoscaler",
  "funding": {
    "type": "GitHub Sponsors ❤",
    "url": "https://github.com/sponsors/CoCreate-app"
  },
  "type": "module",
  "main": "./src/index.js",
  "dependencies": {
    "@cocreate/config": "^1.21.0",
    "@cocreate/utils": "^1.52.0"
  }
}
